{
  "mcpServers": {
    "laravel-boost": {
      "command": "php",
      "args": [
        "artisan",
        "boost:mcp"
      ]
    },
    "trainerdesk-chat": {
      "type": "stdio",
      "command": "${TRAINERDESK_CHAT_PYTHON}",
      "args": [
        "-I",
        "-B",
        "-X",
        "utf8",
        "${TRAINERDESK_CHAT_SERVER}",
        "chat"
      ],
      "env": {
        "AGENT_CHAT_DB": "${TRAINERDESK_CHAT_DB}"
      }
    },
    "playwright": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.38"
      ],
      "env": {
        "MCP_SERVER_REQUEST_TIMEOUT": "120000"
      }
    },
    "firecrawl": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}",
        "MCP_SERVER_REQUEST_TIMEOUT": "120000"
      }
    }
  }
}
