# MCode Observability — Cloud-first (no Docker required)
# Copy this file to .env and fill in real values. Never commit .env.

# Pick one primary backend to avoid double ingestion:
#   latitude  = agent self-healing (signals -> monitors -> MCP fix dispatch)
#   langfuse  = prompt/skill lifecycle + rigorous evaluation (evals, LLM-as-judge)
#   both      = NOT recommended (duplicate ingestion, double cost)
MCODE_OBSERVABILITY_BACKEND=latitude

# ── Latitude (Cloud: https://app.latitude.so) ──────────────────────────
# Get keys from https://app.latitude.so → Project Settings → API keys
LATITUDE_API_KEY=
LATITUDE_PROJECT_SLUG=
# Cloud ingest endpoint (no self-host needed without Docker):
LATITUDE_TELEMETRY_URL=https://ingest.latitude.so/v1/traces

# ── Langfuse (Cloud: https://cloud.langfuse.com) ───────────────────────
# Get keys from https://cloud.langfuse.com → Project Settings → API keys
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# Regions: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US),
# https://jp.cloud.langfuse.com (JP), https://hipaa.cloud.langfuse.com (HIPAA)
LANGFUSE_HOST=https://cloud.langfuse.com
