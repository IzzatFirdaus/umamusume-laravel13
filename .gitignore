# Isolated git worktrees. One is created per parallel dispatch so a peer's uncommitted edits cannot be
# swept into a commit or baked into a bundle; none of them is history material.
/.worktrees/
/testing
/database/*.sqlite*
*.sql

# jev-inspect: keep source, ignore only local artifacts
/jev-inspect/.venv/
/jev-inspect/.venv-Scripts/
/jev-inspect/__pycache__/
/jev-inspect/**/__pycache__/
/jev-inspect/*.pyc
/jev-inspect/dist/
/jev-inspect/build/
/jev-inspect/*.egg-info
/jev-inspect/*.egg
# IDE language-server scratch files written into the framework cache directory
/storage/framework/lsp-*.php

# Impeccable design skill (generated scratch)
/.impeccable/

