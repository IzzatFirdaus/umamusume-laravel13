# Laravel: logs, cache, generated files
*.log
.phpactor.json
.phpunit.result.cache
/.phpunit.cache
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/storage/framework/cache/phpstan
/vendor

# Build artifacts: npm debug logs
npm-debug.log*
yarn-error.log*

# Environment files (never commit local overrides)
.env
.env.*
!.env.example

# OS: Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# A tool once wrote an unexpanded %SystemDrive% as a relative path; the directory is apparatus
# litter, not project state, and `git add -A` would sweep it into a commit.
/%SystemDrive%/

# OS: macOS
.DS_Store

# Editors / IDEs
/.fleet
/.idea
/.nova
/.vscode
/.zed

# Homestead
Homestead.json
Homestead.yaml

