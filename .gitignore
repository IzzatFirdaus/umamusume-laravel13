# Local-only artifacts (this app is never deployed; PRD NFR-1)
/research-scratch/
/.scratch-uma/
/.scratch-merge-preserve/
# A one-off driver script written to the repo ROOT rather than into `.scratch-uma/<session>/`.
# `AGENTS.md` §9 requires session artifacts to live in that session's own subdirectory and holds only
# directories at the `.scratch-uma/` root; this file predates the rule being followed. Ignored by name
# rather than deleted, because it is another session's artifact and not this pass's to remove.
/.scratch-umamusume-laravel13
# Isolated git worktrees. One is created per parallel dispatch so a peer's uncommitted edits cannot be
# swept into a commit or baked into a bundle; none of them is history material.
/.worktrees/
/testing
/database/*.sqlite*
*.sql

# jev-inspect: keep source, ignore only local artifacts
/jev-inspect/.venv/
/jev-inspect/.venv-Scripts/
/jev-inspect/__pycache__/
/jev-inspect/**/__pycache__/
/jev-inspect/*.pyc
/jev-inspect/dist/
/jev-inspect/build/
/jev-inspect/*.egg-info
/jev-inspect/*.egg
# IDE language-server scratch files written into the framework cache directory
/storage/framework/lsp-*.php

# Impeccable design skill (generated scratch)
/.impeccable/

# Research screenshot assets (local reference; ~870 MB, not history material)
/docs/game-screenshots/
/docs/design-research/**/*.png
docs/vibe_images/

# Scratch & temporary development scripts
tools/tmp_*
tools/rebuild-db.*
tools/force-db-rebuild.py
/temp.json
/preflight.php
/storage/sqlite_test.php

# Python cache for tools
tools/__pycache__/

# Audit screenshots and scratch artifacts (local reference; not history material)
/.scratch-audit/
/docs/audits/**/screens/
/docs/audits/**/screenshots/
