{
  "mcpServers": {
    "laravel-boost": {
      "command": "php",
      "args": [
        "artisan",
        "boost:mcp"
      ]
    },
    "playwright": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.38"
      ],
      "env": {
        "MCP_SERVER_REQUEST_TIMEOUT": "120000"
      }
    },
    "firecrawl": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}",
        "MCP_SERVER_REQUEST_TIMEOUT": "120000"
      }
    }
  }
}
