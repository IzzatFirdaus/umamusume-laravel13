{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./database/*.sqlite)",
      "Read(./storage/**)",
      "Read(./node_modules/**)",
      "Read(./vendor/**)",
      "Read(./public/build/**)",
      "Read(./coverage/**)",
      "Read(./dist/**)",
      "Read(./tmp/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|bash|powershell|run_in_terminal|terminal|shell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/claude-pretooluse.mjs",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Task|Agent|task|runSubagent|execution_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/delegate-cap.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|edit|write|create_file|replace_string_in_file|insert_edit_into_file|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/impeccable-post.mjs",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Task|Agent|task|runSubagent|execution_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/delegate-release.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/impeccable-stop.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/headroom-session.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/delegation-log.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
